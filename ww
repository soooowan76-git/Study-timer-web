<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>Smart Study Timer</title>
    <style>
        body { 
            font-family: sans-serif; 
            background: #f0f2f2; 
            display: flex; 
            justify-content: center; 
            align-items: flex-start; 
            flex-wrap: wrap; 
            padding: 30px; 
            gap: 20px; 
        }
        .card { 
            background: white; 
            padding: 30px; 
            border-radius: 10px; 
            box-shadow: 0 4px 6px rgba(0,0,0,0.1); 
            width: 350px;
            box-sizing: border-box;
            text-align: left;
            margin-bottom: 20px;
        }
        .card h2, .card h3 { text-align: center; margin-top: 0; }
        #timer { font-size: 48px; font-weight: bold; margin: 20px 0; color: #2563eb; text-align: center; }
        select { padding: 8px; font-size: 16px; border-radius: 4px; width: 100%; box-sizing: border-box; margin-bottom: 15px; }
        button { padding: 10px 20px; font-size: 16px; margin: 5px 0; border: none; border-radius: 6px; cursor: pointer; transition: background 0.2s; width: 100%; box-sizing: border-box; }
        button:hover { filter: brightness(0.9); }
        .btn-start { background: #16a34a; color: white; }
        .btn-stop { background: #dc2626; color: white; }
        .btn-download { background: #3b82f6; color: white; margin-top: 20px; }
        .btn-reset { background: #6b7280; color: white; margin-top: 5px; }
        
        /* 📊 차트 영역 크기 고정 */
        .chart-box { 
            position: relative; 
            width: 100%; 
            height: 250px; 
            margin-top: 15px; 
        }

        /* 📅 날짜별 기록 리스트 스타일 */
        #history-list {
            list-style: none;
            padding: 0;
            margin: 0;
            max-height: 200px;
            overflow-y: auto;
        }
        #history-list li {
            background: #f8fafc;
            padding: 10px 15px;
            margin-bottom: 8px;
            border-radius: 6px;
            border-left: 4px solid #2563eb;
            display: flex;
            justify-content: space-between;
            font-size: 14px;
        }
    </style>
    <!-- Chart.js 라이브러리 불러오기 -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head> 
<body>
    
    <!-- 왼쪽 카드: 타이머 조작 영역 -->
    <div class="card">
        <h2>⏱️ 스마트 공부 타이머</h2>
        <select id="subject">
            <option value="math">수학</option>
            <option value="english">영어</option>
            <option value="science">과학</option>
            <option value="history">역사</option>
            <option value="programming">프로그래밍</option>
        </select>

        <div id="timer">00:00:00</div>

        <button class="btn-start" onclick="startTimer()">시작</button>
        <button class="btn-stop" onclick="stopTimer()">멈춤 & 저장</button>

        <hr style="margin: 20px 0; border: 0; border-top: 1px solid #eee;">
        
        <button class="btn-download" onclick="downloadRecord()">💾 오늘 기록 다운로드 (.txt)</button>
        <button class="btn-reset" onclick="resetData()">🔄 오늘 기록 초기화</button>
    </div>

    <!-- 오른쪽 영역 (통계 + 날짜별 기록) -->
    <div>
        <!-- 통계 그래프 카드 -->
        <div class="card">
            <h3>과목별 오늘 공부 시간 통계</h3>
            <div class="chart-box">
                <canvas id="studyChart"></canvas>
            </div>
        </div>

        <!-- 📅 날짜별 공부 기록 카드 (선생님 피드백 반영!) -->
        <div class="card">
            <h3>📅 날짜별 공부 기록 캘린더</h3>
            <ul id="history-list">
                <!-- 자바스크립트로 날짜별 기록이 여기에 동적으로 꽂힙니다 -->
            </ul>
        </div>
    </div>

    <script>
        // 오늘 날짜 키 생성 함수
        function getTodayKey() {
            const date = new Date();
            const y = date.getFullYear();
            const m = String(date.getMonth() + 1).padStart(2, '0');
            const d = String(date.getDate()).padStart(2, '0');
            return `studyRecord_${y}-${m}-${d}`;
        }

        // ==========================================
        // 1. 데이터 초기화 및 로컬스토리지 불러오기
        // ==========================================
        let studyData = { math: 0, english: 0, science: 0, history: 0, programming: 0 };
        const currentKey = getTodayKey();
        const savedData = localStorage.getItem(currentKey);
        
        if (savedData !== null) {
            studyData = JSON.parse(savedData); 
        }

        // ==========================================
        // 2. Chart.js 차트 생성 및 설정
        // ==========================================
        const ctx = document.getElementById('studyChart').getContext('2d');
        let studyChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['수학', '영어', '과학', '역사', '프로그래밍'],
                datasets: [{
                    label: '공부 시간 (분)',
                    data: [ studyData.math, studyData.english, studyData.science, studyData.history, studyData.programming ],
                    backgroundColor: [
                        'rgba(255, 99, 132, 0.7)', 'rgba(54, 162, 235, 0.7)', 
                        'rgba(255, 206, 86, 0.7)', 'rgba(75, 192, 192, 0.7)', 'rgba(153, 102, 255, 0.7)'
                    ],
                    borderWidth: 1
                }]
            },
            options: { 
                responsive: true, 
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } } 
            }
        });

        // ==========================================
        // 3. 날짜별 기록 목록 화면에 렌더링하는 함수
        // ==========================================
        function renderHistoryList() {
            const historyListEl = document.getElementById('history-list');
            historyListEl.innerHTML = ''; // 초기화

            let recordCount = 0;

            // 로컬스토리지의 모든 키를 순회하며 'studyRecord_'로 시작하는 데이터를 찾음
            for (let i = 0; i < localStorage.length; i++) {
                const key = localStorage.key(i);
                if (key && key.startsWith('studyRecord_')) {
                    const dateStr = key.replace('studyRecord_', '');
                    const data = JSON.parse(localStorage.getItem(key));
                    const totalMins = data.math + data.english + data.science + data.history + data.programming;

                    if (totalMins > 0) {
                        recordCount++;
                        const li = document.createElement('li');
                        li.innerHTML = `<span><strong>${dateStr}</strong></span> <span><strong>${totalMins}분</strong> 공부함</span>`;
                        historyListEl.appendChild(li);
                    }
                }
            }

            if (recordCount === 0) {
                historyListEl.innerHTML = `<li style="text-align: center; color: #888; border-left-color: #cbd5e1;">아직 저장된 공부 기록이 없어요!</li>`;
            }
        }

        // 페이지가 처음 켜졌을 때 기록 목록 불러오기
        renderHistoryList();

        // ==========================================
        // 4. 차트 업데이트 및 데이터 저장 함수
        // ==========================================
        function updateChart(subject, minutesAdded) {
            studyData[subject] += minutesAdded;
            
            studyChart.data.datasets[0].data = [
                studyData.math, studyData.english, studyData.science, 
                studyData.history, studyData.programming
            ];
            studyChart.update();
            
            localStorage.setItem(currentKey, JSON.stringify(studyData));
            renderHistoryList(); // 기록이 바뀌면 목록도 새로고침
        }

        // ==========================================
        // 5. 타이머 기능
        // ==========================================
        let seconds = 0;
        let timer = null;
        let startTime = 0;

        function updateDisplay() {
            let h = String(Math.floor(seconds / 3600)).padStart(2, '0');
            let m = String(Math.floor((seconds % 3600) / 60)).padStart(2, '0');
            let s = String(seconds % 60).padStart(2, '0');
            document.getElementById('timer').innerText = `${h}:${m}:${s}`;
        }

        function startTimer() {
            if (timer) return;
            startTime = Date.now() - (seconds * 1000);
            timer = setInterval(() => {
                seconds = Math.floor((Date.now() - startTime) / 1000);
                updateDisplay();
            }, 1000);
        }

        function stopTimer() {
            if (!timer && seconds === 0) return;
            clearInterval(timer);
            timer = null;
            
            const subject = document.getElementById('subject').value;
            const minutes = Math.floor(seconds / 60); 
            
            alert(`[${subject}] ${seconds}초 (${minutes}분) 공부를 끝냈어!`);
            
            updateChart(subject, minutes);
            
            seconds = 0;
            updateDisplay();
        }

        // ==========================================
        // 6. 텍스트 파일 다운로드 기능
        // ==========================================
        function downloadRecord() {
            const date = new Date();
            const todayString = `${date.getFullYear()}년 ${date.getMonth() + 1}월 ${date.getDate()}일`;
            
            let textContent = `========== ${todayString} 공부 기록 ==========\n\n`;
            textContent += `📐 수학: ${studyData.math}분\n`;
            textContent += `🔤 영어: ${studyData.english}분\n`;
            textContent += `🔬 과학: ${studyData.science}분\n`;
            textContent += `🏛️ 역사: ${studyData.history}분\n`;
            textContent += `💻 프로그래밍: ${studyData.programming}분\n\n`;
            
            const totalMinutes = studyData.math + studyData.english + studyData.science + studyData.history + studyData.programming;
            textContent += `==========================================\n`;
            textContent += `🔥 총 공부 시간: ${totalMinutes}분\n`;
            textContent += `수고하셨습니다! 내일도 화이팅!`;

            const blob = new Blob([textContent], { type: 'text/plain;charset=utf-8' });
            const fileUrl = URL.createObjectURL(blob);
            
            const tempLink = document.createElement('a');
            tempLink.href = fileUrl;
            tempLink.download = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}_공부기록.txt`; 
            
            document.body.appendChild(tempLink);
            tempLink.click();
            document.body.removeChild(tempLink);
            URL.revokeObjectURL(fileUrl);
        }

        // ==========================================
        // 7. 데이터 초기화 (리셋) 기능
        // ==========================================
        function resetData() {
            const isSure = confirm("정말 오늘의 공부 기록을 모두 0으로 초기화할까요?");
            
            if (isSure) {
                localStorage.removeItem(currentKey);
                studyData = { math: 0, english: 0, science: 0, history: 0, programming: 0 };
                
                studyChart.data.datasets[0].data = [0, 0, 0, 0, 0];
                studyChart.update();
                renderHistoryList();
                
                alert("오늘의 기록이 초기화되었습니다. 화이팅! 🚀");
            }
        }
    </script>
</body>
</html>